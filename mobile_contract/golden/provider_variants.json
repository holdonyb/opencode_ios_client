{
  "name": "providers_payload_variants",
  "description": "providers/models may be object or array; parser must normalize",
  "input": {
    "variant_object": {
      "providers": {
        "openai": {
          "name": "OpenAI",
          "models": {
            "gpt-5.2": { "name": "GPT-5.2", "limit": { "context": 200000 } }
          }
        }
      }
    },
    "variant_array": {
      "providers": [
        {
          "id": "openai",
          "name": "OpenAI",
          "models": [
            { "id": "gpt-5.2", "name": "GPT-5.2", "limit": { "context": 200000 } }
          ]
        }
      ]
    }
  },
  "expected": {
    "normalized_provider_ids": ["openai"],
    "normalized_model_keys": ["openai/gpt-5.2"],
    "context_limit": 200000
  }
}

