{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencode.mobile.session",
  "title": "Session",
  "type": "object",
  "required": ["id", "directory", "title", "time"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string" },
    "projectID": { "type": "string" },
    "directory": { "type": "string" },
    "parentID": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "time": {
      "type": "object",
      "required": ["created", "updated"],
      "properties": {
        "created": { "type": "integer" },
        "updated": { "type": "integer" },
        "archived": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": ["object", "null"],
      "properties": {
        "additions": { "type": "integer" },
        "deletions": { "type": "integer" },
        "files": { "type": "integer" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

